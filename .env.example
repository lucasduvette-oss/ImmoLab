# Copiez ce fichier en « .env.local » puis remplacez les valeurs (voir README, section 3).
# Ne publiez JAMAIS le fichier .env.local (il est déjà exclu de git).

# Supabase > Project Settings > Data API : « Project URL »
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Supabase > Project Settings > API Keys : « Publishable key » (commence par sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase > Project Settings > API Keys : « Secret key » (commence par sb_secret_)
# Utilisée UNIQUEMENT par le script de données de démonstration (npm run demo), jamais par l'application.
# Ne l'ajoutez pas dans Vercel.
SUPABASE_SECRET_KEY=sb_secret_xxx
