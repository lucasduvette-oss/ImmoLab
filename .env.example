# Copiez ce fichier en « .env.local » puis remplacez les valeurs (voir README, sections 4 et 7).
# En local avec « npx supabase start » : URL http://127.0.0.1:54321 et la Publishable key affichée par la commande.
# Ne publiez JAMAIS le fichier .env.local (il est déjà exclu de git).

# Supabase > Project Settings > Data API : « Project URL »
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Supabase > Project Settings > API Keys : « Publishable key » (commence par sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
